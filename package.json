{
  "name": "metaphor-ui-site",
  "version": "0.0.0",
  "private": true,
  "description": "Documentation site for metaphor-ui",
  "license": "MIT",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "preview": "vite preview",
    "typecheck": "tsc --noEmit",
    "lint": "oxlint --deny-warnings && oxfmt --check",
    "format": "oxfmt",
    "build:pages": "node ./tools/build-pages.mjs",
    "preview:pages": "PAGES_BASE=/ pnpm build:pages && python3 -m http.server 6008 --directory .pages",
    "deploy": "node ./tools/deploy.mjs"
  },
  "dependencies": {
    "metaphor-ui": "link:../metaphor/packages/metaphor-ui",
    "react": "19.2.0",
    "react-dom": "19.2.0"
  },
  "devDependencies": {
    "@types/react": "19.2.17",
    "@types/react-dom": "19.2.3",
    "@vitejs/plugin-react": "6.0.3",
    "oxfmt": "0.53.0",
    "oxlint": "1.73.0",
    "playwright": "^1.61.1",
    "typescript": "5.9.3",
    "vite": "8.1.4"
  }
}
